{
  "name": "janar1",
  "version": "1.0.0",
  "description": "Demo app used for TigerGate security scanning",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "test": "jest --coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageReporters": [
      "lcov",
      "text"
    ],
    "collectCoverageFrom": [
      "app.js",
      "ai.js",
      "config.js"
    ],
    "coverageDirectory": "coverage",
    "setupFiles": [
      "<rootDir>/test/setup.js"
    ]
  }
}
